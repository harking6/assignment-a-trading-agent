OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DEEP_MODEL=gpt-4o
OPENAI_BASE_URL=
# DashScope Qwen structured JSON calls default to non-thinking mode. Set true only when a role needs reasoning output.
OPENAI_ENABLE_THINKING=false
# Per-role request controls; smaller values make smoke tests cheaper.
OPENAI_TIMEOUT=30
OPENAI_MAX_TOKENS=800
TRADING_AGENT_MODE=auto
TUSHARE_TOKEN=
